# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_BASE_URL=http://localhost:5000

# Application Configuration
REACT_APP_NAME=Law Mate
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=AI-Powered Legal Companion

# Feature Flags
REACT_APP_ENABLE_AI=true
REACT_APP_ENABLE_TRANSLATION=true
REACT_APP_ENABLE_FILE_UPLOAD=true

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=52428800
REACT_APP_ALLOWED_FILE_TYPES=txt,pdf,png,jpg,jpeg,gif,doc,docx,mp4,avi,mov

# Theme Configuration
REACT_APP_DEFAULT_THEME=legal
REACT_APP_DEFAULT_LANGUAGE=en

# Google Analytics (Optional)
REACT_APP_GA_TRACKING_ID=

# Sentry (Optional)
REACT_APP_SENTRY_DSN=